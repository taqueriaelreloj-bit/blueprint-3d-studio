{
  "name": "blueprint-3d-studio",
  "private": true,
  "version": "0.23.0",
  "type": "module",
  "scripts": {
    "restore": "node scripts/restore-source.cjs",
    "validate": "node scripts/validate-source.cjs",
    "test:unit": "node --test tests/*.test.js",
    "check": "npm run restore && npm run validate && npm run test:unit && npm run build && npm run test:e2e",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
